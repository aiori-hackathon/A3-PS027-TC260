# IPv6 Website & Dependency Readiness Auditor - Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
CONTROLLED_SITE_PORT=8001

# Security & Scanning limits
ALLOW_LOCAL_TEST_DOMAINS=true
MAX_SCAN_TIMEOUT_SEC=60
DEFAULT_SCAN_TIMEOUT_SEC=15
MAX_RESOURCES_PER_AUDIT=150

# Network Vantage Configuration
VANTAGE_LOCATION="Local Workstation / AIORI Lab"
DNS_RESOLVER_IPV4="8.8.8.8"
DNS_RESOLVER_IPV6="2001:4860:4860::8888"

# Database
DB_FILE_PATH="./data/audits.db"
